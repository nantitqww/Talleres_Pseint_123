Algoritmo area_trapecio
    Definir area, base_menor, base_mayor, altura Como Real
	
    Escribir "Vamos a calcular el area de un trapecio"
    Escribir "Digite la base menor"
    Leer base_menor
	
    Escribir "Digite la base mayor"
    Leer base_mayor
	
    Escribir "Digite la altura"
    Leer altura
	
    area = ((base_menor + base_mayor) / 2) * altura
	
    Escribir "El area del trapecio es: ", area
FinAlgoritmo