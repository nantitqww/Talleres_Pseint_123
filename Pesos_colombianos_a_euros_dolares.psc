Algoritmo Pesos_colombianos_a_euros_dolares
    Definir col, USD, EUR Como Real
	
    Escribir "Vamos a convertir pesos colombianos a dolares y euros"
    Escribir "Digite una cantidad en pesos colombianos"
    Leer col
	
    USD = col / 3144
    EUR = col / 3720
	
    Escribir "Valor en dolares: ", USD
    Escribir "Valor en euros: ", EUR
FinAlgoritmo
